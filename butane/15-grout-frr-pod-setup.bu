variant: openshift
version: 4.19.0
metadata:
  name: 15-hbn-grout-frr-setup
  labels:
    machineconfiguration.openshift.io/role: master
systemd:
  units:
    - name: hbn-grout-frr-setup.service
      enabled: true
      contents: |
        [Unit]
        Description=Setup GROUT-FRR Pod
        Before=grout-container.service frr-container.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=-/usr/bin/podman pod stop hbn-grout-frr
        ExecStartPre=-/usr/bin/podman pod rm hbn-grout-frr --ignore
        ExecStart=/usr/bin/podman pod create --name hbn-grout-frr --network none
        ExecStop=/usr/bin/podman pod stop hbn-grout-frr
        ExecStopPost=/usr/bin/podman pod rm hbn-grout-frr --ignore

        [Install]
        WantedBy=multi-user.target
